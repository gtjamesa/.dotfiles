#!/usr/bin/env bash
# clip-prune — delete Raw clips (see GLOSSARY.md) older than 14 days from the
# OBS recordings folder. Kept clips (renamed, or in a subfolder) are never touched.
#
#   clip-prune [--dry-run] [dir]    dir defaults to /mnt/storage/Videos/Recordings
#
# Run daily by config/systemd/user/clip-prune.timer.
set -euo pipefail

MAX_AGE_DAYS=14

dir=/mnt/storage/Videos/Recordings
dry_run=0

for arg in "$@"; do
  case $arg in
  --dry-run) dry_run=1 ;;
  -h | --help)
    echo "Usage: clip-prune [--dry-run] [dir]"
    exit 0
    ;;
  -*)
    echo "unknown option: $arg" >&2
    exit 1
    ;;
  *) dir=$arg ;;
  esac
done

if [ ! -d "$dir" ]; then
  echo "$dir not found, nothing to prune"
  exit 0
fi

# -delete is true only on success, so a failed removal is never logged as deleted
action=(-delete -printf 'deleted %f\n')
[ "$dry_run" = 1 ] && action=(-printf 'would delete %f\n')

# -mtime +N counts whole days, so +13 means at least 14 full days old
find "$dir" -maxdepth 1 -type f -regextype posix-extended \
  -regex '.*/(Replay )?[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}-[0-9]{2}-[0-9]{2}\.mp4' \
  -mtime +$((MAX_AGE_DAYS - 1)) "${action[@]}"
