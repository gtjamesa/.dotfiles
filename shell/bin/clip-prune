#!/usr/bin/env bash
# clip-prune — delete Raw clips (see GLOSSARY.md) older than N days (default 10)
# from the OBS recordings folder. Kept clips (renamed, or in a subfolder) are
# never touched.
#
#   clip-prune [--dry-run] [--days N] [dir]
#
# dir defaults to /mnt/storage/Videos/Recordings.
#
# Run daily by config/systemd/user/clip-prune.timer.
set -euo pipefail

MAX_AGE_DAYS=10
RECORDINGS=/mnt/storage/Videos/Recordings

# A failure is otherwise only visible in the journal
trap '[ $? = 0 ] || notify-send -u critical "clip-prune failed" "journalctl --user -u clip-prune" 2>/dev/null || true' EXIT

dirs=()
dry_run=0

while [ $# -gt 0 ]; do
  case $1 in
  --dry-run) dry_run=1 ;;
  --days)
    [ $# -ge 2 ] || { echo "--days needs a value" >&2; exit 1; }
    MAX_AGE_DAYS=$2
    shift
    ;;
  --days=*) MAX_AGE_DAYS=${1#--days=} ;;
  -h | --help)
    echo "Usage: clip-prune [--dry-run] [--days N] [dir]"
    exit 0
    ;;
  -*)
    echo "unknown option: $1" >&2
    exit 1
    ;;
  *) dirs+=("$1") ;;
  esac
  shift
done

# Also guards the -mtime arithmetic below against injection and N-1 < 0
if ! [[ $MAX_AGE_DAYS =~ ^[1-9][0-9]*$ ]]; then
  echo "--days must be a positive integer, got '$MAX_AGE_DAYS'" >&2
  exit 1
fi

if [ ${#dirs[@]} -gt 1 ]; then
  echo "only one dir allowed, got ${#dirs[@]}" >&2
  exit 1
fi
dir=${dirs[0]-$RECORDINGS}

if [ ! -d "$dir" ]; then
  echo "$dir not found, nothing to prune"
  exit 0
fi

# Absolute and symlink-free: find doesn't follow a symlinked start dir, and
# reads a bare "!" or "(" as an operator
dir=$(realpath -- "$dir")

case $dir/ in
"$(realpath -m -- "$RECORDINGS")"/?*)
  echo "refusing $dir: subfolders of $RECORDINGS hold Kept clips" >&2
  exit 1
  ;;
esac

# A clock running ahead would make every clip look old
if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != yes ]; then
  echo "clock not NTP-synced, skipping"
  exit 0
fi

# -delete is true only on success, so a failed removal is never logged or counted.
# Each line is prefixed with its size in bytes for the awk total
action=(-delete -printf '%s deleted %f\n')
total_verb=cleared
if [ "$dry_run" = 1 ]; then
  action=(-printf '%s would delete %f\n')
  total_verb='would clear'
fi

# -mtime +N counts whole days, so +(days-1) means at least <days> full days old.
# C locale so [0-9] matches ASCII digits only
LC_ALL=C find "$dir" -maxdepth 1 -type f -regextype posix-extended \
  -regex '.*/(Replay )?[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}-[0-9]{2}-[0-9]{2}\.mp4' \
  -mtime +$((MAX_AGE_DAYS - 1)) "${action[@]}" |
  awk -v total_verb="$total_verb" '
    { n++; bytes += $1; sub(/^[0-9]+ /, ""); print }
    END {
      mb = bytes / 1048576
      if (mb >= 1024) printf "%s %.1f GB (%d clips)\n", total_verb, mb / 1024, n
      else printf "%s %.1f MB (%d clips)\n", total_verb, mb, n
    }'
